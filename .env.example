# Application
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database — PostgreSQL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://geomeasure:geomeasure_dev@localhost:5432/geomeasure_db

# For Alembic (sync driver, used only for migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://geomeasure:geomeasure_dev@localhost:5432/geomeasure_db

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=200
MAX_ZIP_ENTRIES=1000

# Storage — relative to the backend directory
UPLOAD_DIR=uploads
TEMP_DIR=tmp

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
