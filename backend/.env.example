# Application
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://geomeasure:geomeasure_dev@localhost:5432/geomeasure_db
DATABASE_URL_SYNC=postgresql+psycopg2://geomeasure:geomeasure_dev@localhost:5432/geomeasure_db

# CORS — comma-separated
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=200
MAX_ZIP_ENTRIES=1000

# Storage paths (relative to backend directory)
UPLOAD_DIR=uploads
TEMP_DIR=tmp

# Logging — use 'console' for readable dev output, 'json' for production
LOG_LEVEL=INFO
LOG_FORMAT=console
